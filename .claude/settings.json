{
  "permissions": {
    "deny": [
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|mcp__fleet__start_session|mcp__fleet__stop_session|mcp__fleet__resume_session",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_paths.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
